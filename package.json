{
  "name": "paleoscope",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "lint": "oxlint",
    "check": "oxlint && tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "evals": "npx -y webmcp-evals@0.0.4 smoke --chrome-channel chrome -u http://localhost:4173/ -e evals/paleoscope.evals.json -v",
    "data": "uv run pipeline/build_dataset.py --raw pipeline/raw --out public/data"
  },
  "devDependencies": {
    "oxlint": "^1.81.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.0"
  }
}
